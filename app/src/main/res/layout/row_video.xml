<?xml version="1.0" encoding="utf-8"?>
<!-- Bento video row: white 20dp card, rounded thumbnail with play badge, name + duration chip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="5dp"
    android:paddingEnd="16dp"
    android:paddingBottom="5dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Bento.Tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:stateListAnimator="@null">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="@color/bento_surfaceVariant"
                app:cardCornerRadius="14dp">

                <ImageView
                    android:id="@+id/image_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ve_play_badge"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ve_ic_play"
                    app:tint="@color/bento_onPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.bumbumapps.videoeditor.MetaFont
                    android:id="@+id/file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="video.mp4"
                    android:textColor="@color/ve_fg"
                    android:textSize="15sp" />

                <com.bumbumapps.videoeditor.MetaFont
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/ve_chip"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:text="duration"
                    android:textColor="@color/ve_fg2"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/ve_ic_back"
                app:tint="@color/ve_fg2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Bento">
        <item name="colorPrimaryDark">@color/bento_surface</item>
        <item name="colorAccent">@color/bento_primary</item>
        <item name="android:statusBarColor">@color/bento_surface</item>
        <item name="android:navigationBarColor">@color/bento_surface</item>
        <item name="android:windowLightStatusBar">@bool/ve_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/ve_light_bars</item>
        <item name="android:iconTint" tools:targetApi="o">@color/ve_fg</item>
    </style>

    <style name="MediaButton">
        <item name="background">@null</item>
        <item name="android:layout_width">88dip</item>
        <item name="android:layout_height">65dip</item>
    </style>

    <style name="ToolbarColoredBackArrow" parent="AppTheme">
        <item name="android:textColorSecondary">@color/ve_fg</item>
        <item name="android:textColor">@color/ve_fg</item>
        <item name="android:textColorPrimary">@color/ve_fg</item>
        <item name="iconTint">@color/ve_fg</item>
        <item name="android:buttonTint">@color/ve_fg</item>
        <item name="itemBackground">@color/bento_surfaceContainerLowest</item>
        <item name="android:itemBackground">@color/bento_surfaceContainerLowest</item>
    </style>
    <style name="AppTheme.AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">@string/ad_attribution</item>
        <item name="android:background">#FFCC66</item>
        <item name="android:width">15dp</item>
        <item name="android:height">15dp</item>
    </style>
    <style name="CustomDialog" parent="android:Theme.Material.Dialog" >
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="color">@android:color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorAccent">@android:color/white</item>
    </style>
</resources>

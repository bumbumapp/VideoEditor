    <!-- Type: Plus Jakarta Sans, few sizes far apart, display tightened. -->
    <style name="Bento.Text.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Bento.Text.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/jakarta_bold</item>

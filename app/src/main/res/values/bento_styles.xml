        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Bento.TextView" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/Bento.Text.Body</item>
    </style>
    <style name="Bento.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/Bento.Text.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/Bento.Text.Body</item>
    </style>

    <!-- Buttons: 16dp corners, title-face labels, press spring. -->
    <style name="Bento.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/Bento.Shape.Button</item>
        <item name="android:textAppearance">@style/Bento.Text.TitleSmall</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@animator/bento_press</item>
    </style>
    <style name="Bento.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/Bento.Shape.Button</item>
        <item name="android:textAppearance">@style/Bento.Text.TitleSmall</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerLowest</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Bento.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/Bento.Shape.Button</item>
        <item name="android:textAppearance">@style/Bento.Text.TitleSmall</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <!-- Square 48dp icon button on a white tile (header actions). -->
    <style name="Bento.IconButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="backgroundTint">?attr/colorSurfaceContainerLowest</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="shapeAppearance">@style/Bento.Shape.Icon</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>
    <!-- Filter / segment chips: white pill, chosen one filled with the accent. -->
    <style name="Bento.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/bento_chip_bg</item>
        <item name="android:textColor">@color/bento_chip_fg</item>
        <item name="android:textAppearance">@style/Bento.Text.TitleSmall</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- Tiles: white tonal surface, 20dp corners, no stroke, no shadow, press spring. -->
    <style name="Bento.Tile" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:stateListAnimator">@animator/bento_press</item>
    </style>
    <!-- Hero tile: full-width accent block, 28dp corners. -->
    <style name="Bento.Hero" parent="Bento.Tile">
        <item name="cardBackgroundColor">@color/bento_hero</item>
        <item name="cardCornerRadius">28dp</item>
    </style>
    <!-- Grouped list card: rows inside one white rounded block (no press spring on the group). -->
    <style name="Bento.Group" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Bento.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bento_popup</item>
        <item name="android:popupElevation">6dp</item>
    </style>
    <style name="ThemeOverlay.Bento.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerExtraLarge">@style/Bento.Shape.ExtraLarge</item>
    </style>
    <style name="ThemeOverlay.Bento.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Bento.Shape.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Bento.Shape.Icon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="Bento.Shape.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
